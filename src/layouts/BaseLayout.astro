---
// Frontmatter: runs at build time, not in the browser.
// We import the shared Navbar and Footer components here
// so every page that uses this layout gets them automatically.
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Accepts a "title" prop from whatever page uses this layout.
const { title = "Bytcra - Best Mobile App, Website & UI/UX Design Solutions" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta property="og:title" content="Bytcra - Best Mobile App, Website & UI/UX Design Solutions">
  <meta property="og:description"
    content="Bytcra IT Services provides expert web development, mobile app solutions, and UI/UX design to help businesses grow with cutting-edge digital technology.">
  <meta property="og:url" content="https://bytcra.com">
  <meta property="og:type" content="website">
  <meta property="og:image" content="https://bytcra.com/images/meta-banner.png">
  <meta property="og:image:alt" content="Bytcra IT Services - Digital Solutions">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="Bytcra - Best Mobile App, Website & UI/UX Design Solutions">
  <meta name="twitter:description"
    content="We offer cutting-edge mobile app development, website development, and UI/UX design services.">
  <meta name="twitter:image" content="https://bytcra.com/images/meta-banner.png">
  <meta name="twitter:image:alt" content="Bytcra IT Services - Digital Solutions">

  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="https://bytcra.com/sitemap.xml">
  <meta name="robots" content="index, follow">

  <title>{title}</title>

  <!-- Font Awesome (icons used in nav, footer, etc.) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

  <!-- Google Analytics — shared across all pages -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DKJBFPY8PQ"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-DKJBFPY8PQ');
  </script>
</head>

<body>
  <Navbar />

  <!-- Each page's unique content gets inserted here -->
  <slot />

  <Footer />

  <!-- Shared JS: navigation, scroll animations -->
  <script is:inline src="/js/nav.js"></script>
  <script is:inline src="/js/scrollAnimation.js"></script>
  <script is:inline src="/js/stickyScroll.js"></script>
  <script is:inline src="/js/contentLoadAnimation.js"></script>
</body>

</html>
