{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "project-k95.bytcra.com"
        }
      ],
      "destination": "/k95/index.html"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "project-k95.bytcra.com"
        }
      ],
      "destination": "/k95/:path*"
    }
  ]
}